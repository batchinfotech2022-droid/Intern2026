@model InternLAApp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Delete Leave";
}

<div class="container mt-4">
    <h2>Delete Leave</h2>

    <h4>Are you sure you want to delete this?</h4>

    <dl class="dl-horizontal">
        <dt>Intern Id</dt>
        <dd>@Model.InternId</dd>

        <dt>From Date</dt>
        <dd>@Model.FromDate.ToShortDateString()</dd>

        <dt>To Date</dt>
        <dd>@Model.ToDate.ToShortDateString()</dd>

        <dt>Reason</dt>
        <dd>@Model.Reason</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Leave", new { id = Model.Id }))
    {
        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    }
</div>