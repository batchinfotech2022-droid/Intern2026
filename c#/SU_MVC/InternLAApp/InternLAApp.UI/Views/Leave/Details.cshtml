@model InternLAApp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Leave Details";
}

<div class="container mt-4">
    <h2>Leave Details</h2>

    <dl class="dl-horizontal">
        <dt>Intern Id</dt>
        <dd>@Model.InternId</dd>

        <dt>From Date</dt>
        <dd>@Model.FromDate.ToShortDateString()</dd>

        <dt>To Date</dt>
        <dd>@Model.ToDate.ToShortDateString()</dd>

        <dt>Reason</dt>
        <dd>@Model.Reason</dd>
    </dl>

    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
</div>