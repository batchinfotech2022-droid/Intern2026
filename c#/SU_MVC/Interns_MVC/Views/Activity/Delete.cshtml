@model Interns_MVC.Models.ActivityModel

@{
    ViewBag.Title = "Delete";
}


<h2>Delete Activity</h2>

<p>Are you sure you want to delete this?</p>

<p>Username: @Model.Username</p>
<p>Activity On: @Model.Activityon</p>
<p>Activity Item: @Model.Activityitem</p>
<p>Activity Date: @Model.Activitydate</p>
<p>Is Success: @Model.Issuccess</p>
<p>Activity Text: @Model.Activitytext</p>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.Activityid)
    <input type="submit" value="Delete" class="btn btn-primary"  />
}

<p>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
</p>