@model Intern_MVC.ViewModels.TestViewModel
@{
    ViewBag.Title = null;
}

<div class="row">
    <div class="col-12">
        <div class="card ">
            <div class="card-body">
                <h1>Testing Form</h1>
                @using (Html.BeginForm("Create", "Test", FormMethod.Post))
                {
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="mb-3">
                        @Html.HiddenFor(m => m.Id)
                        <div class="form-group">
                            @Html.LabelFor(m => m.Name)
                            @Html.TextBoxFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Enabled)
                            @Html.CheckBoxFor(m => m.Enabled)
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Salary)
                            @Html.EditorFor(m => m.Salary, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.Salary, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Language)
                            @Html.DropDownListFor(m => m.Language, Model.LanguageList, "Select Language", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                        </div>
                        <input type="submit" class="btn btn-primary" />
                    </div>

                }
            </div>
            <h1>@ViewBag.Welcome</h1>
        </div>
    </div>
</div>