@model Intern_MVC.ViewModels.LeaveViewModel

<h2>Delete Leave</h2>

<hr />

<div class="card">
    <div class="card-body">

        <h4>Are you sure you want to delete this leave?</h4>

        <dl class="row mt-3">

            <dt class="col-sm-3">Employee Name</dt>
            <dd class="col-sm-9">@Model.EmployeeName</dd>

            <dt class="col-sm-3">Leave Type</dt>
            <dd class="col-sm-9">@Model.LeaveType</dd>

            <dt class="col-sm-3">From Date</dt>
            <dd class="col-sm-9">@Model.FromDate</dd>

            <dt class="col-sm-3">To Date</dt>
            <dd class="col-sm-9">@Model.ToDate</dd>

            <dt class="col-sm-3">Reason</dt>
            <dd class="col-sm-9">@Model.Reason</dd>

            <dt class="col-sm-3">Is Approved</dt>
            <dd class="col-sm-9">@Model.IsApproved</dd>

        </dl>

        @using (Html.BeginForm("DeleteConfirmed", "Leave", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.Id)

            <input type="submit" value="Delete" class="btn btn-danger" />

            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
        }

    </div>
</div>