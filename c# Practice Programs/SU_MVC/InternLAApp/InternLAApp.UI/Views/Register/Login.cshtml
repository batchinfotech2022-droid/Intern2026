@model InternLAApp.UI.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Login";
    Layout = null;
}
<link rel="stylesheet" href="~/Content/bootstrap.min.css">
<link rel="stylesheet" href="~/Content/Site.css">

<div class="login-wrapper d-flex flex-column align-items-center justify-content-center min-vh-100">
    <div class="login-box">
        <div class="card">
            <div class="card-body p-4">

                <h4 class="text-center mb-4">Login</h4>

                @using (Html.BeginForm("Login", "Register", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        @Html.LabelFor(m => m.UserName)
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password)
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    </div>

                    if (ViewBag.Message != null)
                    {
                        <div class="text-danger mb-2">
                            @ViewBag.Message
                        </div>
                    }

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Login
                        </button>
                    </div>
                }

                <div class="text-center mt-3">
                    @Html.ActionLink("Create Account", "Create", "Register")
                </div>

            </div>
        </div>
    </div>
</div>
