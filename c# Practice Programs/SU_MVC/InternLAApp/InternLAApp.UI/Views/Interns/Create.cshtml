@model InternLAApp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Create Leave";
}

<div class="container mt-4">
    <h2>Create Leave</h2>

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>Intern Id</label>
            @Html.TextBoxFor(m => m.InternId, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>From Date</label>
            @Html.TextBoxFor(m => m.FromDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            <label>To Date</label>
            @Html.TextBoxFor(m => m.ToDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            <label>Reason</label>
            @Html.TextAreaFor(m => m.Reason, new { @class = "form-control" })
        </div>

        <br />
        <input type="submit" value="Create" class="btn btn-success" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    }
</div>