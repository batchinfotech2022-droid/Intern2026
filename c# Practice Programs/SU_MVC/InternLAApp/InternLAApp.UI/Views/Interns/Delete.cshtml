@model InternLAApp.UI.Models.InternsModel

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>

@using (Html.BeginForm("Delete", "Interns", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Intern.Id)

    <div>
        <h4>Are you sure you want to delete this intern?</h4>
        <dl class="dl-horizontal">
            <dt>Full name</dt><dd>@Html.DisplayFor(m => m.Intern.FullName)</dd>
            <dt>Date Of Joining</dt><dd>@Html.DisplayFor(m => m.Intern.DateOfJoining)</dd>
            <!-- other fields as needed -->
        </dl>
        <button type="submit" class="btn btn-danger">Delete</button>
        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
    </div>
}