@{
    ViewBag.Title = "Home Page";
}

<div class="card text-bg-dark text-center home-section">
    <img src="images/backk.png" class="card-img home-img" alt="Home Image">
</div>


<div class="container mt-4">
    <h3 class="mb-4 text-center">Dashboard</h3>
    <p class="text-muted text-center mb-4">
        Manage your contacts, categories, and activity all in one place.
    </p>


    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Total Contacts</h5>
                <h2 class="text-primary">120</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Categories</h5>
                <h2 class="text-success">5</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Active Contacts</h5>
                <h2 class="text-info">100</h2>
            </div>
        </div>

    </div>

</div>
<br>



<div class="container px-4 py-5" id="custom-cards">
    <h2 class="pb-2 border-bottom text-center">Features</h2>
    <p class="text-muted text-center mb-4">
        Explore the key functionalities of the Smart Phone Manager system.
    </p>


    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 py-5">

        <div class="col">
            <div class="card h-100">
                <img src="images/draft11.png" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Organized Central Storage</h5>
                    <p class="card-text">Organized Central Storage refers to storing all data in a single, structured location where information is securely maintained and easily accessible, reducing duplication and improving data consistency.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100">
                <img src="images/draft22.png" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Data Accuracy and Validation</h5>
                    <p class="card-text">Data Accuracy and Validation ensure that the entered information is correct, complete, and follows predefined rules, helping prevent errors and maintaining reliable and high-quality data.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100">
                <img src="images/draft33.png" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Quick Search and Management</h5>
                    <p class="card-text">Quick Search and Management allow users to efficiently find, update, and manage data using search, filter, and sorting features, saving time and improving productivity.</p>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="container my-5">
    <h5 class="text-center mb-3">Recent Contacts</h5>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Aditi</td>
                        <td>aditi123@gmail.com</td>
                        <td>Hebri</td>
                        <td>778926522</td>
                    </tr>
                    <tr>
                        <td>Maya</td>
                        <td>maya123@gmail.com</td>
                        <td>Karkala</td>
                        <td>7800865</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
