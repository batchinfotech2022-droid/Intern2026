
@{
    ViewBag.Title = "Edit";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-info text-center text-white rounded">
                        Edit Contact
                    </h2>

                    <form class="mt-4">
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label">Category ID</label>
                                <input type="number" class="form-control" value="109">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" value="Siri">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control"
                                       value="Siri123@gmail.com">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Phone Number</label>
                                <input type="number" class="form-control"
                                       value="7800865">
                            </div>

                            <div class="col-12">
                                <label class="form-label">City</label>
                                <input type="text" class="form-control"
                                       value="Parkala">
                            </div>


                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-success">
                                    Save
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

            <a href="viewcontacts.html" class="back-btn mt-3 d-inline-block">
                <strong>← Back</strong>
            </a>



        </div>
    </div>
</div>

