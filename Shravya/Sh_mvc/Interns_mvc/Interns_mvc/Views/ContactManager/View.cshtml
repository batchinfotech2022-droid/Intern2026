@model Interns_mvc.ViewModels.ContactManagerViewModel

@{
    ViewBag.Title = "View";
}

<h2>View Contact</h2>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>View Contact</span>

        @Html.ActionLink(
            "Back",
            "Index",
            null,
            new { @class = "btn btn-secondary btn-sm" }
        )
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">First Name</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FirstName)</dd>

            <dt class="col-sm-4">Last Name</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.LastName)</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Phone)</dd>

            <dt class="col-sm-4">Created By</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CreatedBy)</dd>

            <dt class="col-sm-4">Created Date</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CreatedDate)</dd>
        </dl>
    </div>
</div>
