@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Edit";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-info text-center text-white rounded">
                        Edit Category
                    </h2>

                    @using (Html.BeginForm("Edit", "Category", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.Id)

                        <div class="mt-4">

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Id, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Id,
                                    new { @class = "form-control", disabled = "disabled" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CategoryName,
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CategoryName,
                                    "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Status</label>

                                @Html.DropDownListFor(m => m.IsActive,
                                    new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "Active", Value = "true", Selected = Model.IsActive },
                                        new SelectListItem { Text = "Inactive", Value = "false", Selected = !Model.IsActive }
                                    },
                                    new { @class = "form-select" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-success">
                                    Save
                                </button>

                                @Html.ActionLink("Cancel", "Index",
                                    null, new { @class = "btn btn-secondary ms-2" })
                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
