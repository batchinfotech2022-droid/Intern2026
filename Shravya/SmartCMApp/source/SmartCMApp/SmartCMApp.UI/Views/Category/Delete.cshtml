@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Delete";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-danger text-center text-white rounded">
                        Delete Category
                    </h2>

                    <h5 class="text-center text-danger mt-3">
                        Are you sure you want to delete this category?
                    </h5>

                    @using (Html.BeginForm("Delete", "Category", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.Id)

                        <div class="mt-4">

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Id, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Id,
                                    new { @class = "form-control", disabled = "disabled" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CategoryName,
                                    new { @class = "form-control", disabled = "disabled" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-danger">
                                    Confirm Delete
                                </button>

                                @Html.ActionLink("Cancel", "Index",
                                    null, new { @class = "btn btn-secondary ms-2" })
                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
