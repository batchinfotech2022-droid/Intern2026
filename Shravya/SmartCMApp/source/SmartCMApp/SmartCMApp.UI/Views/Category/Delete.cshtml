@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Delete";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-danger text-white text-center">
                    <h2 class="mb-0 fw-bold">Delete Category</h2>
                </div>

                @using (Html.BeginForm("Delete", "Category", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)

                    <div class="card-body">

                        <div class="w-75 mx-auto">

                            <!-- ID -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.Id, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Id,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Category Name -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CategoryName,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Warning -->
                            <div class="text-center mt-4">
                                <p class="text-danger fw-bold">
                                    Are you sure you want to delete this category?
                                </p>
                            </div>

                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer bg-white px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            @Html.ActionLink("Back to List", "Index",
                                null, new { @class = "btn btn-secondary px-4" })

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                Confirm Delete
                            </button>

                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</div>