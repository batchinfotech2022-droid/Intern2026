@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Create";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0 fw-bold">Add Category</h2>
                </div>

                @using (Html.BeginForm("Create", "Category", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card-body">

                        <div class="w-75 mx-auto">

                            <!-- Category Name -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CategoryName,
                                    new { @class = "form-control", placeholder = "Enter Category Name" })
                                @Html.ValidationMessageFor(m => m.CategoryName, "",
                                    new { @class = "text-danger" })
                            </div>

                            <!-- Status -->
                            <div class="mb-4">
                                <label class="form-label">Status</label>

                                <div class="form-control bg-light">
                                    Active
                                </div>

                                @Html.HiddenFor(m => m.IsActive, new { Value = "true" })
                            </div>

                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer bg-white px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            @Html.ActionLink("Back", "Index", "Category",
                                null, new { @class = "btn btn-secondary px-4" })

                            <button type="submit"
                                    class="btn btn-success px-4">
                                Save
                            </button>

                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</div>