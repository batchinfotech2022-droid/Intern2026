@model IEnumerable<SmartCMApp.UI.Models.CategoryModel>


@{
    ViewBag.Title = "Category";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white py-3">
            <div class="row align-items-center">

                <div class="col-md-4"></div>

                <div class="col-md-4 text-center">
                    <h4 class="mb-0 fw-semibold">Category</h4>
                </div>

                <div class="col-md-4 text-end">
                    <a href="@Url.Action("Create", "Category")"
                       class="btn btn-success btn-sm rounded-pill px-3">
                        <i class="bi bi-tags-fill me-1"></i> Add Category
                    </a>
                </div>

            </div>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Category Name</th>
                            <th>Status</th>
                            <th colspan="3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoryName</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-primary action-icon"
                                       title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-warning action-icon"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("Delete", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-danger action-icon"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
