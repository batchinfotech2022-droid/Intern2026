@model SmartCMApp.UI.ViewModel.LoginViewModel

@{
    ViewBag.Title = "Login";
    Layout = null;
}

<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .login-wrapper {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: url('/Content/images/login.jpeg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .login-card {
        width: 400px;
        padding: 40px;
        border-radius: 20px;
        background: #e8d5f7;
        backdrop-filter: blur(15px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        color: #000;
    }

        .login-card h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: 600;
            color: #000;
        }

        .login-card label {
            color: #000;
        }

    .form-control {
        width: 100%;
        background: rgba(255,255,255,0.2);
        border: none;
        color: #000;
    }

        .form-control::placeholder {
            color:#000;
        }

        .form-control:focus {
            background: #764ba2;
            box-shadow: none;
            color: black;
        }

    .btn-login {
        width: 100%;
        margin-top: 10px;
        background: white;
        color: #764ba2;
        font-weight: bold;
        border-radius: 10px;
    }

    .register-link {
        text-align: center;
        margin-top: 15px;
    }

        .register-link a {
            color: black;
        }
</style>

<div class="login-wrapper">
    <div class="login-card">

        <h2 >Welcome Back ✨</h2>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(m => m.UserName)
                @Html.TextBoxFor(m => m.UserName,
                    new
                         {
                        @class = "form-control",
                        placeholder = "Enter Email",
                        type = "email"
                    })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password,
                    new
                         {
                        @class = "form-control",
                        placeholder = "Enter Password"
                    })
            </div>

            <button type="submit" class="btn btn-login">
                Login
            </button>
        }

        <div class="register-link">
            @Html.ActionLink("New User? Register", "Register", "Account")
        </div>

    </div>
</div>