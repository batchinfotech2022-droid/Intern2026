@model SmartCMApp.UI.Models.ContactModel

@{
    ViewBag.Title = "Edit";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="mb-0 fw-bold">Edit Contact</h2>
                </div>

                @using (Html.BeginForm("Edit", "Contact", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)

                    <div class="card-body">

                        <div class="w-75 mx-auto">
                            <div class="row">
                                <!-- Full Name -->
                                <div class="col-md-6 mb-4">
                                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.FullName,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.FullName, "",
                                        new { @class = "text-danger" })
                                </div>

                                <!-- Username -->
                                <div class="col-md-6 mb-4">
                                    @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserName,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.UserName, "",
                                        new { @class = "text-danger" })
                                </div>

                                <!-- Phone -->
                                <div class="col-md-6 mb-4">
                                    @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Phone,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Phone, "",
                                        new { @class = "text-danger" })
                                </div>

                                <!-- City -->
                                <div class="col-md-6 mb-4">
                                    @Html.LabelFor(m => m.City, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.City,
                                        new { @class = "form-control" })
                                </div>

                                <!-- Keep Password Hidden -->
                                @Html.HiddenFor(m => m.PassWord)

                                <!-- Category -->
                                <div class="col-md-6 mb-4">
                                    @Html.LabelFor(m => m.CategoryId, new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.CategoryId,
                                        Model.CategoryList,
                                        "Select Category",
                                        new { @class = "form-select" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            @Html.ActionLink("Back", "Index", null,
                                new { @class = "btn btn-secondary px-4" })

                            <button type="submit"
                                    class="btn btn-success px-4">
                                Save
                            </button>

                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>