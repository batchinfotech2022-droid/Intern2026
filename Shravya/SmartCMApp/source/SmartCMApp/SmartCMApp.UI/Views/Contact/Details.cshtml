@model SmartCMApp.UI.Models.ContactModel

@{
    ViewBag.Title = "Details";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0 fw-bold">Contact Details</h2>
                </div>

                <div class="card-body">

                    <div class="w-75 mx-auto">

                        <!-- ID -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.Id, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Id,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <!-- Full Name -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.FullName,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <!-- Username -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.UserName,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <!-- Phone -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Phone,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <!-- City -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.City, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.City,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <!-- Category -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.CategoryId, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.CategoryId,
                                new { @class = "form-control", @readonly = "readonly" })
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="card-footer bg-white px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center">

                        @Html.ActionLink("Back to List", "Index", null,
                            new { @class = "btn btn-secondary px-4" })

                        @Html.ActionLink("Edit", "Edit",
                            new { id = Model.Id },
                            new { @class = "btn btn-primary px-4" })

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>