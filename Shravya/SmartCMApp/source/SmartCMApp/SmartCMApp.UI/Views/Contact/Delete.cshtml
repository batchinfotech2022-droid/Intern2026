@model SmartCMApp.UI.Models.ContactModel

@{
    ViewBag.Title = "Delete";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-danger text-white text-center">
                    <h2 class="mb-0 fw-bold">Delete Contact</h2>
                </div>

                @using (Html.BeginForm("DeleteConfirmed", "Contact", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)

                    <div class="card-body">

                        <div class="w-75 mx-auto">
                            <div class="row">
                            

                            <!-- Full Name -->
                            <div class="col-md-6 mb-4">
                                @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FullName,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Username -->
                            <div class="col-md-6 mb-4">
                                @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.UserName,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6 mb-4">
                                @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Phone,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- City -->
                            <div class="col-md-6 mb-4">
                                @Html.LabelFor(m => m.City, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.City,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                            <!-- Warning -->
                            <div class="text-center mt-4 ">
                                <p class="text-danger fw-bold fs-6">
                                    Are you sure you want to delete this contact?
                                </p>
                            </div>

                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer bg-white px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            @Html.ActionLink("Back to List", "Index", null,
                                new { @class = "btn btn-secondary px-4" })

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                Yes, Delete
                            </button>

                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</div>