@model IEnumerable<SmartCMApp.UI.Models.ContactModel>

@{
    ViewBag.Title = "Index";
    int serial = 1;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white py-3">
            <div class="row align-items-center">

                <!-- SEARCH + FILTER -->
                <div class="col-md-4">
                    @using (Html.BeginForm("Index", "Contact", FormMethod.Get))
                    {
                        <div class="d-flex gap-2">

                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white">
                                    🔍
                                </span>
                                <input type="text" name="search"
                                       value="@Request.QueryString["search"]"
                                       class="form-control"
                                       placeholder="Search by name" />
                            </div>

                            <select name="categoryId"
                                    class="form-select form-select-sm w-auto">
                                <option value="">All</option>
                                @if (ViewBag.CategoryList != null)
                                {
                                    foreach (var item in ViewBag.CategoryList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>

                            <button type="submit" class="btn btn-light btn-sm">
                                Filter
                            </button>

                        </div>
                    }
                </div>

                <!-- TITLE -->
                <div class="col-md-4 text-center">
                    <h4 class="mb-0 fw-semibold">Contacts</h4>
                </div>

                <!-- CREATE BUTTON -->
                <div class="col-md-4 text-end">
                    @Html.ActionLink("+ Create", "Create", null,
                        new { @class = "btn btn-success btn-sm" })
                </div>

            </div>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>S.No</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>Phone</th>
                            <th colspan="3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>
                                <td>@item.FullName</td>
                                <td>@item.UserName</td>
                                <td>@item.City</td>
                                <td>@item.Phone</td>

                                <td>
                                    @Html.ActionLink("Edit", "Edit",
                                        new { id = item.Id },
                                        new { @class = "btn btn-primary btn-sm" })
                                </td>

                                <td>
                                    @Html.ActionLink("Details", "Details", new { id = item.Id },
    new { @class = "btn btn-success btn-sm" })

                                </td>

                                <td>
                                    @Html.ActionLink("Delete", "Delete",
                                        new { id = item.Id },
                                        new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>

                            serial++;
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
