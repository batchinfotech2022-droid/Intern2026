@model SmartCMApp.UI.Models.ContactModel

@{
    ViewBag.Title = "Create";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0 fw-bold">Add Contact</h2>
                </div>

                @using (Html.BeginForm("Create", "Contact", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card-body">

                        <div class="w-75 mx-auto">

                            <!-- Full Name -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FullName,
                                    new { @class = "form-control", placeholder = "Enter Full Name" })
                            </div>

                            <!-- Phone -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Phone,
                                    new { @class = "form-control", placeholder = "Enter Phone Number" })
                            </div>

                            <!-- City -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.City, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.City,
                                    new { @class = "form-control", placeholder = "Enter City" })
                            </div>

                            <!-- Email -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.UserName,
                                    new { @class = "form-control", placeholder = "you@example.com" })
                            </div>

                            <!-- Password -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.PassWord, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.PassWord,
                                    new { @class = "form-control", placeholder = "Enter Password" })
                            </div>

                            <!-- Category -->
                            <div class="mb-4">
                                @Html.Label("Category", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.CategoryId,
                                    Model.CategoryList,
                                    "Select Category",
                                    new { @class = "form-select" })
                            </div>

                        </div>
                    </div>

                    <div class="card-footer bg-white px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            <a href="@Url.Action("Index","Contact")"
                               class="btn btn-secondary px-4">
                                Back to list
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                Save
                            </button>

                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>