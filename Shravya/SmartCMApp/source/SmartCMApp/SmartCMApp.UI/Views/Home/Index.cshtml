@model SmartCMApp.UI.Models.HomeModel
@{
    ViewBag.Title = "Home Page";
}

@* Link the separate CSS — place Home.css inside Content/css/ folder *@
<link href="@Url.Content("~/Content/css/Home.css")" rel="stylesheet" />

@* ===== HERO SECTION (replaces the old card+image) ===== *@
<section class="hero-section">

    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
    <div class="hero-grid"></div>

    <div class="hero-content">
        <div class="hero-badge">Smart Contact Manager</div>

        <h1 class="hero-title">
            Manage Your Contacts<br>
            <span>Smarter &amp; Faster</span>
        </h1>

        <p class="hero-subtitle">
            One place to store, organize, and access all your contacts —
            with powerful search, categories, and real-time management.
        </p>

        <div>
            <a href="#dashboard" class="hero-btn hero-btn-primary">Get Started</a>
            <a href="#custom-cards" class="hero-btn hero-btn-outline">Explore Features</a>
        </div>

        @*<div class="hero-stats">
            <div class="hero-stat">
                <a href="#dashboard" class="hero-btn hero-btn-primary">Get Started</a>
                <a href="#custom-cards" class="hero-btn hero-btn-outline">Explore Features</a>

            </div>
            <div class="hero-stat">
                <div class="hero-stat-number">@Model.TotalCategories</div>
                <div class="hero-stat-label">Categories</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-number">@Model.ActiveContacts</div>
                <div class="hero-stat-label">Active</div>
            </div>
        </div>*@
    </div>

    @*<div class="hero-scroll">
        <span>Scroll</span>
        <div class="hero-scroll-line"></div>
    </div>*@

</section>

@* ===== DASHBOARD (unchanged) ===== *@
<div class="container mt-4" id="dashboard">
    <h3 class="mb-4 text-center">Dashboard</h3>
    <p class="text-muted text-center mb-4">
        Manage your contacts, categories, and activity all in one place.
    </p>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Total Contacts</h5>
                <h2 class="text-primary">@Model.TotalContacts</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Categories</h5>
                <h2 class="text-success">@Model.TotalCategories</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow text-center p-4">
                <h5>Active Contacts</h5>
                <h2 class="text-info">@Model.ActiveContacts</h2>
            </div>
        </div>
    </div>
</div>
<br>

@* ===== FEATURES CARDS (unchanged) ===== *@
<div class="container px-4 py-5" id="custom-cards">
    <h2 class="pb-2 border-bottom text-center">Features</h2>
    <p class="text-muted text-center mb-4">
        Explore the key functionalities of the Smart Contact Manager system.
    </p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 py-5">
        <div class="col">
            <div class="card h-100">
                <img src="@Url.Content("~/Content/images/draft11.png")" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Organized Central Storage</h5>
                    <p class="card-text">
                        Store all contacts in one structured system with easy access and consistency.
                    </p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <img src="@Url.Content("~/Content/images/draft22.png")" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Data Accuracy and Validation</h5>
                    <p class="card-text">
                        Ensures correct and validated data entry to maintain high quality records.
                    </p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <img src="@Url.Content("~/Content/images/draft33.png")" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">Quick Search and Management</h5>
                    <p class="card-text">
                        Search, filter, and manage contacts quickly and efficiently.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ===== RECENT CONTACTS (unchanged) ===== *@
<div class="container my-5">
    <h5 class="text-center mb-3">Recent Contacts</h5>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model.RecentContacts)
                    {
                        <tr>
                            <td>@contact.FullName</td>
                            <td>@contact.UserName</td>
                            <td>@contact.City</td>
                            <td>@contact.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
