@model SmartCMApp.UI.Models.ContactModel

@{
    ViewBag.Title = "Edit";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-info text-center text-white rounded">
                        Edit Contact
                    </h2>

                    @using (Html.BeginForm("Edit", "Contact", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.Id)

                        <div class="mt-4">

                            <div class="mb-3">
                                @Html.LabelFor(m => m.FullName)
                                @Html.TextBoxFor(m => m.FullName,
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Email)
                                @Html.TextBoxFor(m => m.Email,
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Phone)
                                @Html.TextBoxFor(m => m.Phone,
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.City)
                                @Html.TextBoxFor(m => m.City,
                                    new { @class = "form-control" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.CategoryId)
                                @Html.DropDownListFor(m => m.CategoryId,
                                    ViewBag.CategoryList as SelectList,
                                    "Select Category",
                                    new { @class = "form-select" })
                            </div>

                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-success">
                                    Save
                                </button>
                            </div>

                        </div>
                    }

                </div>
            </div>

            <div class="mt-3 text-center">
                @Html.ActionLink("Back", "Index", null,
                    new { @class = "btn btn-secondary" })
            </div>

        </div>
    </div>
</div>
