@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Details";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-info text-center text-white rounded">
                        Category Details
                    </h2>

                    <div class="mt-4">

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Id, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Id,
                                new { @class = "form-control", disabled = "disabled" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.CategoryName,
                                new { @class = "form-control", disabled = "disabled" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Status</label>

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </div>

                        <div class="text-center mt-3">
                            @Html.ActionLink("Back to List", "Index",
                                null, new { @class = "btn btn-secondary" })
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
