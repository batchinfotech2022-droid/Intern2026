@model SmartCMApp.UI.Models.CategoryModel

@{
    ViewBag.Title = "Create";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-info text-center text-white rounded">
                        Add Category
                    </h2>

                    @using (Html.BeginForm("Create", "Category", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mt-4">

                            <div class="mb-3">
                                @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CategoryName,
                                    new { @class = "form-control", placeholder = "Enter Category Name" })
                                @Html.ValidationMessageFor(m => m.CategoryName, "",
                                    new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Status</label>

                                @Html.DropDownListFor(m => m.IsActive,
                                    new List<SelectListItem>
                                    {
                                        new SelectListItem{ Text="Active", Value="true" },
                                        new SelectListItem{ Text="Inactive", Value="false" }
                                    },
                                    new { @class = "form-select" })

                                @Html.ValidationMessageFor(m => m.IsActive, "",
                                    new { @class = "text-danger" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-success">
                                    Save Category
                                </button>
                            </div>

                        </div>
                    }

                </div>
            </div>

            <div class="mt-3">
                @Html.ActionLink("← Back", "Index", "Category",
                    null, new { @class = "btn btn-secondary" })
            </div>

        </div>
    </div>
</div>
