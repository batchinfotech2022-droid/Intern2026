<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
   
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("BiSchool", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="nav navbar-nav" style="display:flex; gap:25px; margin-left:30px;">
                    <li>
                        @Html.ActionLink("Home", "Index", "Home", null, new { @style = "text-decoration:none; font-weight:500; color:white;" })
                    </li>
                    <li>
                        @Html.ActionLink("Student", "Index", "Student", null, new { @style = "text-decoration:none; font-weight:500; color:white;" })
                    </li>
                    <li>
                        @Html.ActionLink("Fees", "Index", "Fees", null, new { @style = "text-decoration:none; font-weight:500; color:white;" })
                    </li>
                    <li>
                        @Html.ActionLink("Batch", "Index", "Batch", null, new { @style = "text-decoration:none; font-weight:500; color:white;" })
                    </li>
                    <li>
                        @Html.ActionLink("StudentBatch", "Index", "StudentBatch", null, new { @style = "text-decoration:none; font-weight:500; color:white;" })
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - BiSchool</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/chart.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
