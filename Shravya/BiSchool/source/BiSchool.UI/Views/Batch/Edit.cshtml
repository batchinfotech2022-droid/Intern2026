@model BiSchool.UI.Models.BatchModel

<div class="container mt-4">
    <div class="card custom-card center-card">
        <div class="card-header bg-primary text-white">
            Edit Batch
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Timing, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Timing, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Subject, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Update</button>
                    @Html.ActionLink("Back", "Index", null,
                        new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>