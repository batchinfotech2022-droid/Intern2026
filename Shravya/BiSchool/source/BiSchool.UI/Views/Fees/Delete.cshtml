@model BiSchool.UI.ViewModels.FeesViewModel

@{
    ViewBag.Title = "Delete Fee";
}

<h2>Delete Fee</h2>

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to delete this fee record?
</div>

<div class="card p-3">
    <dl class="row">

        <dt class="col-sm-3">
            Student Name
        </dt>
        <dd class="col-sm-9">
            @Model.StudentName
        </dd>

        <dt class="col-sm-3">
            Amount
        </dt>
        <dd class="col-sm-9">
            @Model.Amount
        </dd>

        <dt class="col-sm-3">
            Date
        </dt>
        <dd class="col-sm-9">
            @Model.Date.ToString("dd MMM yyyy")
        </dd>

    </dl>
</div>

<br />

@using (Html.BeginForm("DeleteConfirmed", "Fees", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <input type="submit" value="Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
}