@model BiSchool.UI.ViewModels.FeesViewModel

@{
    ViewBag.Title = "Create";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="p-3 bg-danger text-center text-white rounded">
                        Create Fees
                    </h2>

                    @using (Html.BeginForm("Create", "Fees", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mt-4">

                            <!-- StudentID -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.StudentId, "Student")
                                @Html.DropDownListFor(
                                    m => m.StudentId,
                                    Model.Students,
                                    "-- Select Student --",
                                    new { @class = "form-control select2" }
                                )
                                @Html.ValidationMessageFor(m => m.StudentId, "", new { @class = "text-danger" })
                            </div>


                            <!-- Amount -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.Amount)
                                @Html.TextBoxFor(
                                    m => m.Amount,
                                    new { @class = "form-control", placeholder = "Enter Amount" }
                                )
                                @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                            </div>

                            <!-- Date -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.Date)
                                @Html.TextBoxFor(
    m => m.Date,
    new { @class = "form-control flatpickr-date", placeholder = "Select Date" }

                                )
                                @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })
                            </div>





                            <input type="submit" value="Create" class="btn btn-success" />
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })


                        </div>
                    }

                </div>
            </div>



        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {

            
            $(".select2").select2({
                placeholder: "Select Student",
                allowClear: false
            });

            
            flatpickr(".flatpickr-date", {
                dateFormat: "Y-m-d"
            });

        });
    </script>
}