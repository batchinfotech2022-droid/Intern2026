
@model IEnumerable<BiSchool.UI.ViewModels.FeesViewModel>
@using BiSchool.UI.IDEncryption



<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
            <h5 class="mb-0">Fees Pay List</h5>
            @Html.ActionLink("+Create", "Create", null, new { @class = "btn btn-light btn-sm" })
        </div>



        <div class="card-body">
            <table class="table table-striped table-hover table-bordered text-center">
                <thead class="table-dark">

                    <tr>
                        <th>Student Name</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentName</td>
                                <td>₹ @(item.Amount.ToString("N2"))</td>
                                <td>@(item.Date?.ToString("dd MMM yyyy"))</td>
                                <td>
                                    @Html.EncodedActionLink("Edit", "Edit","Fees", new { id = item.Id },
                                        new { @class = "btn btn-sm btn-primary me-1" })

                                    @Html.EncodedActionLink("Details", "Details","Fees", new { id = item.Id },
                                        new { @class = "btn btn-sm btn-info text-white me-1" })

                                    @Html.EncodedActionLink("Delete", "Delete","Fees", new { id = item.Id },
                                        new { @class = "btn btn-sm btn-danger" })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-muted">
                                No records found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<h3>Monthly Fees Collection</h3>
<canvas id="feesChart" height="100"></canvas>

@section Scripts {
    <script>
        var ctx = document.getElementById('feesChart').getContext('2d');

        var feesChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr'],
                datasets: [{
                    label: 'Fees Collection',
                    data: [12000, 18000, 15000, 22000],
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(255, 99, 132, 0.6)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}
