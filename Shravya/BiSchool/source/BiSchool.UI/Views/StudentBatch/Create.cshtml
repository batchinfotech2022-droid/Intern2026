@model BiSchool.UI.Models.StudentBatchModel

@{
    ViewBag.Title = "Create Student Batch";
}

<h2>Create Student Batch</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.BatchId)
        @Html.DropDownListFor(model => model.BatchId,
            (SelectList)ViewBag.BatchList,
            "-- Select Batch --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.BatchId)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.StudentId)
        @Html.DropDownListFor(model => model.StudentId,
            (SelectList)ViewBag.StudentList,
            "-- Select Student --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.StudentId)
    </div>

    <br />
    <input type="submit" value="Create" class="btn btn-success" />
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
}