@model BiSchool.UI.Models.StudentBatchModel

@{
    ViewBag.Title = "Edit Assignment";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Edit Student Batch Assignment</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="card shadow">
            <div class="card-body">

                <div class="mb-3">
                    @Html.LabelFor(m => m.BatchId, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.BatchId, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.StudentId, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.StudentId, new { @class = "form-control" })
                </div>

                <button type="submit" class="btn btn-primary">Update</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })

            </div>
        </div>
    }
</div>