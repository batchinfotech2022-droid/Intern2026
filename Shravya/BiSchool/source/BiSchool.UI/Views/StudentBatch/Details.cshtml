@model BiSchool.UI.Models.StudentBatchModel

@{
    ViewBag.Title = "Details";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Student Batch Details</h2>

    <div class="card shadow">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Batch</dt>
                <dd class="col-sm-9">@Model.BatchTitle</dd>

                <dt class="col-sm-3">Student</dt>
                <dd class="col-sm-9">@Model.StudentName</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.CreatedDate</dd>
            </dl>

            @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary ms-2" })

        </div>
    </div>
</div>