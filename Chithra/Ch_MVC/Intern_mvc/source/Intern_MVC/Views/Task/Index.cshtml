
@model IEnumerable<Intern_MVC.ViewModels.TaskViewModel>



<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Tasks List</h5>

        @Html.ActionLink(
            "Create Task",
            "Create",
            null,
            new { @class = "btn btn-primary btn-sm" }
        )
    </div>

    <div class="card-body">
        <table class="table table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.First().Title)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Description)</th>
                    <th>@Html.DisplayNameFor(m => m.First().CreatedDate)</th>
                    <th>@Html.DisplayNameFor(m => m.First().IsActive)</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.CreatedDate.ToShortDateString()</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @Html.ActionLink(
                                    "Edit",
                                    "Edit",
                                    new { id = item.Id },
                                    new { @class = "btn btn-success btn-sm" }
                                )
                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    new { id = item.Id },
                                    new { @class = "btn btn-danger btn-sm" }
                                )
                                @Html.ActionLink(
                                    "View",
                                    "View",
                                    new { id = item.Id },
                                    new { @class = "btn btn-success btn-sm" }
                                )

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
