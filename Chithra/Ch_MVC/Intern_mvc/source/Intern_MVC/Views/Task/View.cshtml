@model Intern_MVC.ViewModels.TaskViewModel

<div class="card">
    <div class="card-body">

        <div class="form-group row">
            <label class="col-sm-3 col-form-label">
                @Html.LabelFor(m => m.Title)
            </label>
            <div class="col-sm-9">
                <p class="form-control-plaintext">@Model.Title</p>
            </div>
        </div>


        <div class="form-group row">
            <label class="col-sm-3 col-form-label">
                @Html.LabelFor(m => m.Description)
            </label>
            <div class="col-sm-9">
                <p class="form-control-plaintext">@Model.Description</p>
            </div>
        </div>


        <div class="form-group row">
            <label class="col-sm-3 col-form-label">
                @Html.LabelFor(m => m.CreatedDate)
            </label>
            <div class="col-sm-9">
                <p class="form-control-plaintext">
                    @Model.CreatedDate
                </p>
            </div>
        </div>

        <div class="form-group row">
            <label class="col-sm-3 col-form-label">

                @Html.CheckBoxFor(m => m.IsActive, new { disabled = "disabled" })
                @Html.LabelFor(m => m.IsActive)
                </label>
        </div>


        @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary " })


    </div>
</div>
