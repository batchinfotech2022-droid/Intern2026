@model IEnumerable<Intern_MVC.Models.ActivityModel>


@{
    ViewBag.Title = "Activity List";
}

<h2>Activity List</h2>

<p>
    @Html.ActionLink("Create New Activity", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Activityid)</th>
            <th>@Html.DisplayNameFor(m => m.Username)</th>
            <th>@Html.DisplayNameFor(m => m.Activityon)</th>
            <th>@Html.DisplayNameFor(m => m.Activityitem)</th>
            <th>@Html.DisplayNameFor(m => m.Activitydate)</th>
            <th>@Html.DisplayNameFor(m => m.Issuccess)</th>
            <th>@Html.DisplayNameFor(m => m.Activitytext)</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Activityid</td>
                <td>@item.Username</td>
                <td>@item.Activityon</td>
                <td>@item.Activityitem</td>
                <td>@item.Activitydate?.ToString("yyyy-MM-dd")</td>
                <td>@item.Issuccess</td>
                <td>@item.Activitytext</td>

                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Activityid }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Activityid }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Activityid })
                </td>
            </tr>
        }
    </tbody>
</table>
