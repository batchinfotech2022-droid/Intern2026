@model IEnumerable<BiSchool.UI.Models.StudentModel>
@using BiSchool.UI.IDEncription

@{
    ViewBag.Title = "Students";
}

<h2>Student List</h2>

<p>
    @Html.ActionLink("Create New Student", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
           
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Is Active</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>
                    @Html.CheckBoxFor(m => item.IsAdmin, new { disabled = "disabled" })
                </td>
                <td>
                    @Html.EncodedActionLink("Edit", "Edit", "Student", new { id = item.Id }, new { @class = "btn btn-primary btn-sm" })
                    @Html.EncodedActionLink("Details", "Details", "Student", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })
                    @Html.EncodedActionLink("Delete", "Delete", "Student", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })

                </td>
            </tr>
        }
    </tbody>
</table>
