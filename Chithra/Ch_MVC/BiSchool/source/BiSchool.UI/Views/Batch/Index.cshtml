

@model IEnumerable<BiSchool.UI.Models.BatchModel>
@using BiSchool.UI.IDEncription
@{
    ViewBag.Title = "Batches";
}

<h2>Batch List</h2>

<p>
    @Html.ActionLink("Create New Batch", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            
            <th>Title</th>
            <th>Timing</th>
            <th>Subject</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Timing</td>
                <td>@item.Subject</td>
                <td>
                    @Html.EncodedActionLink("Edit", "Edit","Batch",new { id = item.Id }, new { @class = "btn btn-primary btn-sm" })
                    @Html.EncodedActionLink("Details", "Details", "Batch", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })
                    @Html.EncodedActionLink("Delete", "Delete", "Batch", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>