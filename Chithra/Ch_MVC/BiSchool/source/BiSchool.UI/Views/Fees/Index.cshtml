@model IEnumerable<BiSchool.UI.Models.FeesModel>
@using BiSchool.UI.IDEncription

@{
    ViewBag.Title = "Fees";
}

<h2>Fees List</h2>

<p>
    @Html.ActionLink("Create New Fees", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Student</th>
            <th>Amount</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.StudentName</td>
                <td>@item.Amount</td>
                <td>@item.Date.ToShortDateString()</td>
                <td>
                    @Html.EncodedActionLink("Edit", "Edit", "Fees", new { id = item.Id }, new { @class = "btn btn-primary btn-sm" })
                    @Html.EncodedActionLink("Details", "Details", "Fees", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })
                    @Html.EncodedActionLink("Delete", "Delete", "Fees", new { id = item.Id }, new { @class = "btn btn-secondary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>