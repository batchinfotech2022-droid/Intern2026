@model BiSchool.UI.Models.FeesModel

@{
    ViewBag.Title = "Edit Fees";
}

<h2>Edit Fees</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="form-horizontal">

        <div class="form-group">
            @Html.LabelFor(m => m.StudentId)
            @Html.DropDownListFor(m => m.StudentId,
                ViewBag.StudentList as SelectList,
                "-- Select Student --",
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.StudentId)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Amount)
            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Amount)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Date)
            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}",
                new { @type = "date", @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Date)
        </div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-primary" />
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
        </div>

    </div>
}