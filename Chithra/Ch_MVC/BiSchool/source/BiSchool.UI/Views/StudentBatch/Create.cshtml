@model BiSchool.UI.Models.StudentBatchModel
@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>


@using (Html.BeginForm())
{
    <h2>Assign Student To Batch</h2>

    <div class="form-group">
        @Html.LabelFor(m => m.BatchId)
        @Html.DropDownListFor(m => m.BatchId,
            ViewBag.BatchList as SelectList,
            "-- Select Batch --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.StudentId)
        @Html.DropDownListFor(m => m.StudentId,
            ViewBag.StudentList as SelectList,
            "-- Select Student --",
            new { @class = "form-control" })
    </div>

    <input type="submit" value="Save" class="btn btn-primary" />
}