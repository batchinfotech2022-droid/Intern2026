@model UserTaskApp.UI.Models.TaskModel

<div class="container mt-4">

    <div class="card shadow col-md-8 mx-auto">

        <div class="card-header bg-secondary text-white">
            <h5>Delete Task</h5>
        </div>

        <div class="card-body px-5 py-4">

            <h6 class="text-danger">Are you sure want to Delete this Task?</h6>
            @Html.HiddenFor(model => model.Id)

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Title</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.Title" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Description</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.Description" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">AssignedTo</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.AssignedTo" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Status</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.Status" readonly />
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Delete" class="btn btn-danger" />



                </div>
            }

        </div>
    </div>
</div>