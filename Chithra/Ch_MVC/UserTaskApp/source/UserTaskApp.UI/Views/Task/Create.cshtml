@model UserTaskApp.UI.Models.TaskModel

@{
    ViewBag.Title = "Create Task";
}

<div class="container mt-4">

    <div class="card shadow col-md-8 mx-auto">

        <div class="card-header bg-secondary text-white">
            <h5 class="mb-2 mt-2">Create Task</h5>
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                
                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.Title)
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.Description)
                    @Html.TextAreaFor(m => m.Description,
                        new { @class = "form-control", rows = 3 })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.AssignedTo)
                    @Html.DropDownListFor(m => m.AssignedTo,
                        (IEnumerable<SelectListItem>)ViewBag.Users,
                        "-- Select User --",
                        new { @class = "form-control select2-task" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.Status)
                    @Html.DropDownListFor(m => m.Status,
                        (IEnumerable<SelectListItem>)ViewBag.StatusList,
                        "-- Select Status --",
                        new { @class = "form-control" })
                </div>

                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Back to List", "Index", null,
                        new { @class = "btn btn-secondary" })

                    <input type="submit" value="Create Task" class="btn btn-success" />
                </div>
            }

        </div>
    </div>
</div>
@section scripts{
    <script>
    $(document).ready(function () {
        $('.select2-task').select2({
            placeholder: "Select User ",
            allowClear: true
        });
    });
    </script>
    
    }