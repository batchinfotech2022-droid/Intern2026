@model UserTaskApp.UI.Models.TaskModel

<div class="container mt-4">

    <div class="card shadow col-md-8 mx-auto">

        <div class="card-header bg-secondary text-white">
            <h5>Edit Task</h5>
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.HiddenFor(m => m.Id)

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title)
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description)
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.AssignedTo)
                    @Html.DropDownListFor(m => m.AssignedTo, (IEnumerable<SelectListItem>)ViewBag.Users, "-- Select --", new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Status)
                    @Html.DropDownListFor(m => m.Status, (IEnumerable<SelectListItem>)ViewBag.StatusList, "-- Select --", new { @class = "form-control" })
                </div>

                <div class="d-flex justify-content-between">
                    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Update" class="btn btn-success" />
                </div>
            }

        </div>
    </div>
</div>