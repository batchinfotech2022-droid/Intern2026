@model UserTaskApp.UI.Models.UserModel

<div class="container mt-4">

    <div class="card shadow col-md-8 mx-auto">

        <div class="card-header bg-secondary text-white">
            <h5 class="mb-2 mt-2">Delete User</h5>
        </div>


        <div class="card-body px-5 py-4">

            <h6 class="text-danger ">Are you sure you want to delete this user?</h6>
            @Html.HiddenFor(model => model.Id)

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Username</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.UserName" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">First Name</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.FirstName" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Last Name</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.LastName" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Phone</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.Phone" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 fw-bold">Address</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.Address" readonly />
                </div>
            </div>

            <div class="mb-4 row align-items-center">
                <label class="col-sm-4 fw-bold">Active</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control py-2 px-3" value="@Model.IsActive" readonly />
                </div>
            </div>


            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Delete" class="btn btn-danger" />



                </div>
            }

        </div>
   </div>
    </div>
