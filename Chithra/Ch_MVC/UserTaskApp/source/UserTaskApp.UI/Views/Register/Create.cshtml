@model UserTaskApp.UI.Models.RegisterModel
    @{ 
        Layout = null;
    }


<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<div class="container h-100">

    <div class="row h-100 justify-content-center align-items-center">

        <div class="col-md-4">

            <div class="card shadow-lg">

                <div class="card-body p-4">

                    <h4 class="text-center mb-4">Login</h4>

                    @using (Html.BeginForm("Create", "Register", FormMethod.Post))
                    {

                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            @Html.LabelFor(m => m.UserName)
                            @Html.TextBoxFor(m => m.UserName,
                                new { @class = "form-control", placeholder = "Example@gmail.com" })
                            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName,
                                new { @class = "form-control", placeholder = "Example" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName,
                                new { @class = "form-control", placeholder = "Example" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password)
                            @Html.PasswordFor(m => m.Password,
                                new { @class = "form-control", placeholder = "Enter password" })
                            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })

                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Phone)
                            @Html.PasswordFor(m => m.Phone,
                                new { @class = "form-control", placeholder = "Enter password" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Address)
                            @Html.PasswordFor(m => m.Address,
                                new { @class = "form-control", placeholder = "Enter password" })
                        </div>
                        @Html.ActionLink("Login", "Index", null, new { @class = "btn btn-secondary" })
                    }

                </div>
            </div>

        </div>

    </div>

</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


