@model InternLAApp.UI.Models.AttendanceModel

@{
    ViewBag.Title = "Delete Attendance";
}

<div class="container mt-4">
    <h2>Delete Attendance</h2>

    <h4>Are you sure you want to delete this?</h4>

    <dl class="dl-horizontal">
        <dt>Intern Id</dt>
        <dd>@Model.InternId</dd>

        <dt>Date</dt>
        <dd>@Model.AttendanceDate.ToShortDateString()</dd>

        <dt>Status</dt>
        <dd>@Model.Status</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Attendance", new { id = Model.Id }))
    {
        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    }
</div>