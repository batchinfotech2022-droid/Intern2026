@model InternLAApp.UI.Models.AttendanceModel

@{
    ViewBag.Title = "Create Attendance";
}

<div class="container mt-4">
    <h2>Create Attendance</h2>

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>Intern Id</label>
            @Html.TextBoxFor(m => m.InternId, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Date</label>
            @Html.TextBoxFor(m => m.AttendanceDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            <label>Status</label>
            @Html.DropDownListFor(m => m.Status,
                new List<SelectListItem>
                {
                    new SelectListItem { Text = "Present", Value = "Present" },
                    new SelectListItem { Text = "Absent", Value = "Absent" }
                },
                "-- Select --",
                new { @class = "form-control" })
        </div>

        <br />
        <input type="submit" value="Create" class="btn btn-success" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    }
</div>