@model InternLAApp.UI.Models.InternsModel

<div class="card shadow p-3 mb-3">
    <div class="card-header bg-danger text-white">
        <h3>Delete Intern</h3>
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete this intern?</p>
        <p><strong>Full Name:</strong> @Model.FullName</p>
        <p><strong>Date Of Joining:</strong> @Model.DateOfJoining.ToShortDateString()</p>
        <p><strong>Available Leave:</strong> @Model.AvailableLeave</p>

        <form action="/Interns/DeleteConfirmed" method="post" style="display:inline-block;">
            <input type="hidden" name="Id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <a href="/Interns/Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>