@model InternLAApp.UI.Models.InternsModel

<div class="card shadow p-3 mb-3">
    <div class="card-header">
        <h3>Edit Intern</h3>
    </div>
    <div class="card-body">
        <form action="/Interns/Edit" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="FullName" class="form-label">Full Name</label>
                <input type="text" name="FullName" class="form-control" value="@Model.FullName" />
            </div>

            <div class="mb-3">
                <label for="DateOfJoining" class="form-label">Date of Joining</label>
                <input type="date" name="DateOfJoining" class="form-control" value="@Model.DateOfJoining.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label for="AvailableLeave" class="form-label">Available Leave</label>
                <input type="number" name="AvailableLeave" class="form-control" value="@Model.AvailableLeave" />
            </div>

            <button type="submit" class="btn btn-success">Save</button>
        </form>
    </div>
</div>