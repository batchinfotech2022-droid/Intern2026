@model IEnumerable<InternLAApp.UI.Models.InternsModel>

@{
    ViewBag.Title = "Interns";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Interns List</h3>
        <a href="@Url.Action("Create", "Interns")" class="btn btn-primary">Add New Intern</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Sl. No</th>
                    <th>Full Name</th>
                    <th>Date Of Joining</th>
                    <th>Available Leave</th>
                    <th colspan="3" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var intern in Model)
                    {
                        <tr>
                            <td>@intern.Id</td>
                            <td>@intern.FullName</td>
                            <td>@intern.DateOfJoining.ToString("yyyy-MM-dd")</td>
                            <td>@intern.AvailableLeave</td>
                            <td>
                                <a href="@Url.Action("Edit", "Interns", new { id = intern.Id })" class="btn btn-success btn-sm">Edit</a>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "Interns", new { id = intern.Id })" class="btn btn-info btn-sm">View</a>
                            </td>
                            <td>
                                <a href="@Url.Action("Delete", "Interns", new { id = intern.Id })" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No interns found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>