@{@{
        ViewBag.Title = "Home";
        Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <div class="container mt-4">
        <div class="row align-items-center">
            <div class="col-md-5 text-center">
                <img src="https://pnccs.edu.in/wp-content/uploads/2024/10/teamwork-puzzle-pieces-complete-success-illustration_1314935-46307.jpg"
                     class="img-fluid rounded" alt="Intern Management">
            </div>
            <div class="col-md-7">
                <h4 class="text-center mb-3 text-danger fw-bold">
                    Simple and Efficient Intern Management
                </h4>
                <p class="lead text-justify">
                    The Intern Attendance System is designed to streamline the management of
                    interns in an organized and efficient manner. It allows administrators to easily track
                    daily attendance, manage leave requests, and maintain accurate intern records. By
                    automating routine tasks, this system reduces manual effort, ensures precise reporting,
                    and enhances overall productivity. With a user-friendly interface and real-time data
                    tracking, it provides a reliable solution for smooth intern management.
                </p>
                <div class="mt-4 d-flex gap-2 flex-wrap justify-content-center">
                    <a href="@Url.Action("Index", "Interns")" class="btn btn-primary">Manage Interns</a>
                    <a href="@Url.Action("Index", "Attendance")" class="btn btn-success">Track Attendance</a>
                    <a href="@Url.Action("Index", "Leave")" class="btn btn-warning text-white">Manage Leaves</a>
                    <a href="@Url.Action("Index", "Activity")" class="btn btn-info text-white">View Activities</a>
                </div>
            </div>
        </div>
    </div>
</main>