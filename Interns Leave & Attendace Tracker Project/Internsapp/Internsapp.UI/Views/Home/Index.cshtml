@{
    ViewBag.Title = "Home";
}

<div class="container body-content">

    <!-- HERO -->
    <div class="hero-section mb-5">
        <h1>Intern Leave & Attendance Management</h1>
        <p>Smart tracking • Easy approvals • Transparent records</p>
    </div>

    <!-- ABOUT -->
    <div class="section">
        <div class="row align-items-center g-5">
            <div class="col-md-6">
                <h2 class="fw-bold mb-3">
                    A Smart Intern Management System
                </h2>

                <p class="text-muted">
                    InternsApp helps organizations track intern attendance,
                    manage leave requests, and maintain accurate records —
                    all in one simple and efficient platform.
                </p>

                <ul class="text-muted mt-3">
                    <li>✔ Attendance tracking</li>
                    <li>✔ Leave requests & approval</li>
                    <li>✔ Centralized intern records</li>
                    <li>✔ Clean dashboards & reports</li>
                </ul>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984"
                     class="img-fluid"
                     style="border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,.15);"
                     alt="Intern Management" />
            </div>
        </div>
    </div>

    <!-- FEATURES -->
    <div class="section features-section mt-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold">What We Offer</h2>
            <p class="text-muted">
                Everything you need to manage interns efficiently
            </p>
        </div>

        <div class="row g-4">

            <!-- Attendance -->
            <div class="col-md-4">
                <div class="card feature-card text-center">
                    <div class="feature-icon bg-blue mb-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h5 class="fw-bold">Attendance Tracking</h5>
                    <p class="text-muted">
                        Daily attendance monitoring with accurate reporting.
                    </p>
                </div>
            </div>

            <!-- Leave -->
            <div class="col-md-4">
                <div class="card feature-card text-center">
                    <div class="feature-icon bg-purple mb-3">
                        <i class="bi bi-envelope-paper"></i>
                    </div>
                    <h5 class="fw-bold">Leave Management</h5>
                    <p class="text-muted">
                        Easy leave requests with approval workflow.
                    </p>
                </div>
            </div>

            <!-- Intern -->
            <div class="col-md-4">
                <div class="card feature-card text-center">
                    <div class="feature-icon bg-green mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="fw-bold">Intern Records</h5>
                    <p class="text-muted">
                        Centralized and secure intern information.
                    </p>
                </div>
            </div>

        </div>
    </div>

</div>