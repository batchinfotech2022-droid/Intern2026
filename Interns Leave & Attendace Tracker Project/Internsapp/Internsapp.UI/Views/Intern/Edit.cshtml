@model Internsapp.UI.Models.InternModel
@{
    ViewBag.Title = "Edit Intern";
}

<div class="container mt-4">
    

        <div class="card page-card">
            <div class="card-header header-edit">
                <h5 class="mb-0">✏️ Edit Intern</h5>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Edit", "Intern", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.Password)

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.UserName)
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Phone)
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Address)
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-semibold">Status</label>
                            <div class="form-check mt-2">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                <label class="form-check-label ms-2">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-soft-secondary" })
                        <input type="submit" value="Update Changes" class="btn btn-success px-4" />
                    </div>
                }
            </div>
        </div>
</div>