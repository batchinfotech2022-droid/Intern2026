@model Internsapp.UI.Models.InternModel
@{
    ViewBag.Title = "Delete Intern";
}

<div class="container mt-4">
    <div class="card page-card">

        <div class="card-header header-delete">
            <h5 class="mb-0">Delete Intern</h5>
        </div>

        <div class="card-body">

            <!-- Warning message -->
            <div class="d-flex align-items-start gap-3 mb-4">
                <div class="text-danger fs-3">⚠️</div>
                <div>
                    <h6 class="fw-bold mb-1">
                        Are you sure you want to delete intern
                        <strong>@Model.UserName</strong>?
                    </h6>
                    <p class="mb-0 text-muted">
                        
                        This action cannot be undone.
                    </p>
                </div>
            </div>

            <!-- Intern summary -->
            <div class="border rounded-3 p-3  mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>
                </dl>
            </div>

            @using (Html.BeginForm("Delete", "Intern", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-soft-secondary" })
                    <input type="submit" value="Yes, Delete Intern" class="btn btn-danger px-4" />
                </div>
            }
        </div>
    </div>
</div>