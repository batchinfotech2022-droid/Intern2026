@model Internsapp.UI.Models.InternModel

<div class="container mt-4">
    <div class="card shadow page-card">
        <div class="card-header bg-primary text-white">
            <h5>Delete Intern</h5>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this intern?
            </div>            <dl class="row">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.UserName</dd>
                <dt class="col-sm-3">First Name</dt>
                <dd class="col-sm-9">@Model.FirstName</dd>
                <dt class="col-sm-3">Last Name</dt>
                <dd class="col-sm-9">@Model.LastName</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Intern", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            }
        </div>
    </div>
</div>