@model Internsapp.UI.Models.InternModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- TOASTR -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        body {
            height: 100vh;
            background: linear-gradient(135deg,#eef1ff,#f9fbff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-card {
            width: 950px;
            min-height: 540px;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.15);
            background: #fff;
        }

        .left-section {
            padding: 50px;
        }

        .title-text {
            font-weight: 700;
            margin-bottom: 35px;
            color: #2d2d2d;
        }

        .form-control {
            border: none;
            border-bottom: 2px solid #e0e0e0;
            border-radius: 0;
            padding-left: 0;
        }

            .form-control:focus {
                box-shadow: none;
                border-bottom: 2px solid #6c63ff;
            }

        .register-btn {
            background: linear-gradient(135deg,#6c63ff,#5a54d1);
            border: none;
            padding: 14px;
            border-radius: 30px;
            color: white;
            font-weight: 600;
            letter-spacing: .5px;
            transition: .3s;
            box-shadow: 0 10px 20px rgba(108,99,255,.3);
        }

            .register-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 15px 25px rgba(108,99,255,.4);
            }

        .right-section {
            position: relative;
        }

            .right-section img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .right-section::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(20,20,40,0.25);
            }

        .login-link a {
            color: #6c63ff;
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="main-card row g-0">

        <!-- LEFT -->
        <div class="col-md-6 left-section">

            <h3 class="title-text">Intern Registration</h3>

            @using (Html.BeginForm("Register", "Intern", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-6 mb-4">
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First Name" })
                    </div>

                    <div class="col-md-6 mb-4">
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Last Name" })
                    </div>

                    <div class="col-md-12 mb-4">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Username" })
                    </div>

                    <div class="col-md-12 mb-4">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password" })
                    </div>

                    <div class="col-md-12 mb-4">
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Phone Number" })
                    </div>

                    <div class="col-md-12 mb-4">
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Address" })
                    </div>

                </div>

                <div class="d-grid">
                    <button type="submit" class="register-btn">Register</button>
                </div>
            }

            <div class="text-center mt-4 login-link">
                Already registered?
                <a href="@Url.Action("Login","Intern")">Login</a>
            </div>

        </div>


        <!-- RIGHT -->
        <div class="col-md-6 right-section">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTwObxNP1zuxS4LPexSTcsG_GT7xmX9UDEhBA&s" />
        </div>

    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
        toastr.success('@TempData["Success"]');
        </script>
    }

</body>
</html>