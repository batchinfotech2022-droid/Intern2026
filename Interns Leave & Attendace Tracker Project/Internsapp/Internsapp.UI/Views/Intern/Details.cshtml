@model Internsapp.UI.Models.InternModel
@{
    ViewBag.Title = "Intern Details";
}

<div class="container mt-4">
    

        <div class="card page-card">
            <div class="card-header header-details">
                <h5 class="mb-0">📄 Intern Details</h5>
            </div>

            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>

                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@Model.LastName</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="status-text @(Model.IsActive ? "active" : "inactive")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>
                </dl>

                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-soft-secondary" })
                    @Html.ActionLink("Edit Intern", "Edit", new { id = Model.Id }, new { @class = "btn btn-success px-4" })
                </div>
            </div>
        </div>
</div>