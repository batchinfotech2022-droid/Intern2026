@model Internsapp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Leave Details";
}

<div class="container mt-4">
    <div class="card page-card">
        <div class="card-header header-details">
            <h5 class="page-title mb-0">Leave Details</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Intern</dt>
                <dd class="col-sm-8">@Model.InternName</dd>

                <dt class="col-sm-4">From Date</dt>
                <dd class="col-sm-8">@Model.FromDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">To Date</dt>
                <dd class="col-sm-8">@Model.ToDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">Reason</dt>
                <dd class="col-sm-8">@Model.Reason</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                @Html.ActionLink("Edit Leave", "Edit", new { id = Model.Id }, new { @class = "btn btn-success" })
            </div>
        </div>
    </div>
</div>