@model Internsapp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Delete Leave";
}

<div class="container mt-4">

    <div class="card shadow page-card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Delete Leave</h5>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this leave?
            </div>
            <dl class="row">
                <dt class="col-sm-4">Intern</dt>
                <dd class="col-sm-8">@Model.InternName</dd>

                <dt class="col-sm-4">From</dt>
                <dd class="col-sm-8">@Model.FromDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">To</dt>
                <dd class="col-sm-8">@Model.ToDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">Reason</dt>
                <dd class="col-sm-8">@Model.Reason</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            }

        </div>
    </div>
</div>