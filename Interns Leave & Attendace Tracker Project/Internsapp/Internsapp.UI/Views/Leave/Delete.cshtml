@model Internsapp.UI.Models.LeaveModel

@{
    ViewBag.Title = "Delete Leave";
}

<div class="container mt-4">
    <div class="card page-card">

        <!-- Header -->
        <div class="card-header header-delete">
            <h5 class="page-title mb-0">Delete Leave</h5>
        </div>

        <!-- Body -->
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete leave for
                <strong>@Model.InternName</strong>?
            </div>

            <dl class="row">
                <dt class="col-sm-4">From Date</dt>
                <dd class="col-sm-8">@Model.FromDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">To Date</dt>
                <dd class="col-sm-8">@Model.ToDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">Reason</dt>
                <dd class="col-sm-8">@Model.Reason</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between mt-4">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-back" })
                    <input type="submit" value="Delete Leave" class="btn btn-danger" />
                </div>
            }

        </div>
    </div>
</div>