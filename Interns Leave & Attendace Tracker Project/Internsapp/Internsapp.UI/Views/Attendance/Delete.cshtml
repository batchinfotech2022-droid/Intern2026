@model Internsapp.UI.Models.AttendanceModel
@{
    ViewBag.Title = "Delete Attendance";
}

<div class="container mt-4">
    <div class="card shadow page-card">

        <div class="card-header header-delete">
            <h5 class="mb-0">Delete Attendance</h5>
        </div>

        <div class="card-body">

            <div class="alert">
                Are you sure you want to delete attendance of
                <strong>@Model.InternName</strong>?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.AttendanceDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between mt-4">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-back" })
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            }
        </div>
    </div>
</div>