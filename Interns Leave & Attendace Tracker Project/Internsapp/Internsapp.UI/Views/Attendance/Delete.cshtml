@model Internsapp.UI.Models.AttendanceModel

@{
    ViewBag.Title = "Delete Attendance";
}

<div class="container mt-4">

    <div class="card shadow page-card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-2 mt-2">Delete Attendance</h5>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this record?
            </div>
            <dl class="row">

                @Html.HiddenFor(m => m.Id)

                <dt class="col-sm-4">Intern Name</dt>
                <dd class="col-sm-8">@Model.InternName</dd>

                <dt class="col-sm-4">Attendance Date</dt>
                <dd class="col-sm-8">@Model.AttendanceDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="d-flex justify-content-between mt-3">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            }

        </div>
    </div>
</div>