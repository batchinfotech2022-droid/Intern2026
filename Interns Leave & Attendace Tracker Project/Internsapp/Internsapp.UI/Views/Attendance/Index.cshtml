@model IEnumerable<Internsapp.UI.Models.AttendanceModel>
@{
    ViewBag.Title = "Attendance";
}

<div class="container mt-4">
    <div class="card page-card">

        <div class="card-header header-index d-flex justify-content-between align-items-center">
            <h5 class="page-title mb-0">Attendance Records</h5>

            <div class="header-tools">
                <input type="text" id="attendanceSearch"
                       class="form-control form-control-sm"
                       placeholder="Search intern..." style="width:200px" />

                <select id="attendanceFilter" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="present">Present</option>
                    <option value="absent">Absent</option>
                    <option value="leave">Leave</option>
                    <option value="half">Half Day</option>
                </select>

                @Html.ActionLink("Add Attendance", "Create", "Attendance",
                    null, new { @class = "btn btn-outline-light btn-sm" })
            </div>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Intern</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.InternName</td>
                            <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="status-badge @item.Status.ToLower()">
                                    @item.Status
                                </span>
                            </td>

                            <td class="text-center text-nowrap">
                                <a class="action-btn edit" href="@Url.Action("Edit", new { id = item.Id })">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="action-btn view" href="@Url.Action("Details", new { id = item.Id })">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="action-btn delete" href="@Url.Action("Delete", new { id = item.Id })">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }

                    <tr class="no-records d-none">
                        <td colspan="4" class="text-center text-muted py-4">
                            No records found
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
