@model Internsapp.UI.Models.AttendanceModel
@{
    ViewBag.Title = "Add Attendance";
}

<div class="container mt-4">
    <div class="card shadow page-card">

        <div class="card-header header-create">
            <h5 class="mb-0">Add Attendance</h5>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.InternId, "Intern")
                    @Html.DropDownListFor(m => m.InternId,
                        (SelectList)ViewBag.Interns,
                        "Select Intern",
                        new { @class = "form-select" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.AttendanceDate)
                    @Html.TextBoxFor(m => m.AttendanceDate,
                        "{0:yyyy-MM-dd}",
                        new { @class = "form-control", type = "date" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Status)
                    @Html.DropDownListFor(m => m.Status,
                        (SelectList)ViewBag.StatusList,
                        "Select Status",
                        new { @class = "form-select" })
                </div>

                <div class="d-flex justify-content-between mt-4">
                    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-back" })
                    <button type="submit" class="btn btn-success px-4">Save</button>
                </div>
            }
        </div>
    </div>
</div>