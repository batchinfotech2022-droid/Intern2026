@model Internsapp.UI.Models.AttendanceModel
@{
    ViewBag.Title = "Attendance Details";
}

<div class="container mt-4">
    <div class="card shadow page-card">

        <div class="card-header header-details">
            <h5 class="mb-0">Attendance Details</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Intern</dt>
                <dd class="col-sm-8">@Model.InternName</dd>

                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.AttendanceDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-back" })
                @Html.ActionLink("Edit", "Edit", new { id = Model.Id },
                    new { @class = "btn btn-success px-4" })
            </div>
        </div>
    </div>
</div>