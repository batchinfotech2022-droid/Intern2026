@model IEnumerable<Intern_MVC.ViewModels.LeaveViewModel>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Leave Applications</h5>

        @Html.ActionLink(
            "Apply Leave",
            "Create",
            null,
            new { @class = "btn btn-primary btn-sm" }
        )
    </div>

    <div class="card-body">
        <table class="table table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.First().EmployeeName)</th>
                    <th>@Html.DisplayNameFor(m => m.First().LeaveType)</th>
                    <th>@Html.DisplayNameFor(m => m.First().FromDate)</th>
                    <th>@Html.DisplayNameFor(m => m.First().ToDate)</th>
                    <th>@Html.DisplayNameFor(m => m.First().IsApproved)</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeName</td>
                        <td>@item.LeaveType</td>
                        <td>@item.FromDate.ToShortDateString()</td>
                        <td>@item.ToDate.ToShortDateString()</td>
                        <td>
                            @if (item.IsApproved)
                            {
                                <span class="badge badge-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Pending</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @Html.ActionLink(
                                    "Edit",
                                    "Edit",
                                    new { id = item.Id },
                                    new { @class = "btn btn-success btn-sm" }
                                )
                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    new { id = item.Id },
                                    new { @class = "btn btn-danger btn-sm" }
                                )
                                @Html.ActionLink(
                                    "View",
                                    "View",
                                    new { id = item.Id },
                                    new { @class = "btn btn-success btn-sm" }
                                )
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>