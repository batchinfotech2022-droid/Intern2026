@model BiSchool.UI.Models.FeesModel

<div class="container mt-4">
    <div class="card custom-card center-card">
        <div class="card-header bg-primary text-white">
            Create Fees
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.LabelFor(m => m.StudentId)
                    @Html.DropDownListFor(m => m.StudentId,
                        ViewBag.StudentList as SelectList,
                        "-- Select Student --",
                        new { @class = "form-control select2" })
                </div>


                <div class="mb-3">
                    @Html.LabelFor(m => m.Amount, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Date, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}",
                        new { @type = "date", @class = "form-control" })
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Save</button>
                    @Html.ActionLink("Cancel", "Index", null,
                        new { @class = "btn btn-secondary" })
                </div>
            }

        </div>
    </div>
</div>
