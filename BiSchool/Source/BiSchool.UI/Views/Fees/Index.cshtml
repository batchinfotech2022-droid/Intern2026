@model IEnumerable<BiSchool.UI.Models.FeesModel>
@using BiSchool.UI.IDEncryption;
<div class="container mt-4">
    <div class="card custom-card">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
            <span>Fees List</span>
            @Html.ActionLink("Create New", "Create", null,
                new { @class = "btn btn-light btn-sm text-primary fw-bold" })
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped align-middle" id="tblfees">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Student</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentName</td>
                                <td>₹ @item.Amount</td>
                                <td>@item.Date.ToShortDateString()</td>
                                <td class="text-center">

                                    @Html.EncodedActionLink("Edit", "Edit", "Fees", new { id = item.Id },
                                        new { @class = "btn btn-primary btn-sm me-1" })

                                    @Html.EncodedActionLink("Details", "Details", "Fees", new { id = item.Id },
                                        new { @class = "btn btn-outline-primary btn-sm me-1" })

                                    @Html.EncodedActionLink("Delete", "Delete", "Fees", new { id = item.Id },
                                        new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            let table = new DataTable('#tblfees');
        });
    </script>

}