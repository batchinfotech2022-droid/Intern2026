@{
    ViewBag.Title = "Home";
}

<div class="container-fluid bg-light">

    <div class="container min-vh-100 d-flex align-items-center">

        <div class="row align-items-center w-100">


            <div class="col-md-6">

                <h1 class="fw-bold text-primary mb-4">
                    BiSchool Management System
                </h1>

                <p class="fs-5 text-muted">
                    A smart and efficient platform to manage students,
                    batches and fee records with accuracy and simplicity.
                </p>

                <p class="text-secondary">
                    Designed to streamline administrative tasks and provide
                    a structured system for educational institutions.
                </p>

            </div>


            <div class="col-md-6 text-center">

                <img src="~/Content/images/sc.jpg"
                     class="img-fluid rounded shadow"
                     alt="School Management"
                     style="width:80%; max-width:auto;" />

            </div>

        </div>

    </div>

</div>

<h3 class="mt-4">Fees Collection</h3>

<div class="chart-container" style="height:300px;">
    <canvas id="feesChart"></canvas>
</div>

@section Scripts {

    <script>
    $(document).ready(function () {
        getFeesChartData();
    });

    function getFeesChartData() {
        $.ajax({
            url: '@Url.Action("GetFeesChartData", "Home")',
            type: 'GET',
            success: function (data) {
                console.log("Chart Data:", data); // DEBUG

                var labels = [];
                var values = [];

                for (var i = 0; i < data.length; i++) {
                    labels.push(data[i].Month);
                    values.push(data[i].Amount);
                }

                renderChart(labels, values);
            },
            error: function () {
                alert("Failed to load fees chart data");
            }
        });
    }

    function renderChart(labels, values) {
        const ctx = document.getElementById('feesChart').getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Fees Amount (₹)',
                    data: values,
                    backgroundColor: 'rgba(54, 162, 235, 0.8)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }
    </script>
}