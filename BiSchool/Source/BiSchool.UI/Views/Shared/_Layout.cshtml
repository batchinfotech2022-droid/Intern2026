<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm">
        <div class="container">

            @Html.ActionLink("BiSchool", "Index", "Home", new { area = "" },
                new { @class = "navbar-brand fw-bold" })

            <button type="button" class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex ">
                <ul class="navbar-nav">

                    <li class="nav-item">
                        @Html.ActionLink("Home", "Index", "Home",
                            null, new { @class = "nav-link text-white" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Student", "Index", "Student",
                            null, new { @class = "nav-link text-white" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Fees", "Index", "Fees",
                            null, new { @class = "nav-link text-white" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Batch", "Index", "Batch",
                            null, new { @class = "nav-link text-white" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Student Batch", "Index", "StudentBatch",
                            null, new { @class = "nav-link text-white" })
                    </li>

                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year -BiSchool Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
