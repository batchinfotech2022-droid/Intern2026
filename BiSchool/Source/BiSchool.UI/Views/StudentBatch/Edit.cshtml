@model BiSchool.UI.Models.StudentBatchModel

<div class="container mt-4">
    <div class="card custom-card center-card">
        <div class="card-header bg-primary text-white">
            Edit Student Batch
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="mb-3">
                    <label class="form-label fw-semibold">Batch ID</label>
                    @Html.TextBoxFor(m => m.BatchId, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Student ID</label>
                    @Html.TextBoxFor(m => m.StudentId, new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Batch</label>
                    <input class="form-control" value="@Model.BatchTitle" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Student</label>
                    <input class="form-control" value="@Model.StudentName" readonly />
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Update</button>
                    @Html.ActionLink("Back", "Index", null,
                        new { @class = "btn btn-secondary" })
                </div>
            }

        </div>
    </div>
</div>