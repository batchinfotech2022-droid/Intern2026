@model BiSchool.UI.Models.StudentBatchModel

<div class="container mt-4">
    <div class="card custom-card center-card text-center">
        <div class="card-header bg-primary text-white">
            Delete Student Batch
        </div>

        <div class="card-body">

            <p class="text-danger fw-bold">
                Are you sure you want to delete this record?
            </p>

            <p><strong>Batch:</strong> @Model.BatchTitle</p>
            <p><strong>Student:</strong> @Model.StudentName</p>

            @using (Html.BeginForm("Delete", "StudentBatch", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <button type="submit" class="btn btn-danger me-2">
                    Delete
                </button>

                @Html.ActionLink("Cancel", "Index", null,
                        new { @class = "btn btn-secondary" })
            }
        </div>
    </div>
</div>