@model BiSchool.UI.Models.StudentBatchModel

<div class="container mt-4">
    <div class="card custom-card center-card">
        <div class="card-header bg-primary text-white">
            Create Student Batch
        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()



                <div class="form-group">
                    @Html.LabelFor(m => m.StudentId)
                    @Html.DropDownListFor(m => m.StudentId,
                        ViewBag.StudentList as SelectList,
                        "-- Select Student --",
                        new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.BatchId)
                    @Html.DropDownListFor(m => m.BatchId,
                        ViewBag.BatchList as SelectList,
                        "-- Select Batch --",
                        new { @class = "form-control" })
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Save</button>
                    @Html.ActionLink("Back", "Index", null,
                        new { @class = "btn btn-secondary" })
                </div>
            }

        </div>
    </div>
</div>