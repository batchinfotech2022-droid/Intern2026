@model IEnumerable<BiSchool.UI.Models.StudentBatchModel>
@using BiSchool.UI.IDEncryption;

<div class="container mt-4">
    <div class="card custom-card">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
            <span>Student Batch List</span>
            @Html.ActionLink("Create New", "Create", null,
                new { @class = "btn btn-light btn-sm text-primary fw-bold" })
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped align-middle">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Batch</th>
                            <th>Student</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BatchTitle</td>
                                <td>@item.StudentName</td>
                                <td class="text-center">

                                    @Html.EncodedActionLink("Edit", "Edit","StudentBatch", new { id = item.Id },
                                        new { @class = "btn btn-primary btn-sm me-1" })

                                    @Html.EncodedActionLink("Details", "Details", "StudentBatch", new { id = item.Id },
                                        new { @class = "btn btn-outline-primary btn-sm me-1" })

                                    @Html.EncodedActionLink("Delete", "Delete", "StudentBatch", new { id = item.Id },
                                        new { @class = "btn btn-danger btn-sm" })

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>