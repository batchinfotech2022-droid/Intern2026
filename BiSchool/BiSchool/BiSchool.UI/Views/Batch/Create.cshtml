@model BiSchool.UI.Models.BatchModel

@{
    ViewBag.Title = "Create Batch";
}

<h2>Create Batch</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Timing)
        @Html.TextBoxFor(m => m.Timing, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Timing, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Subject)
        @Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary" })
}